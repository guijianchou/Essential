<Page
    x:Class="LocalSecurityAudit.Views.DashboardPageEnhanced"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="Transparent">
    <Page.Resources>
        <Style x:Key="LayerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MetricCompactStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" Height="56" Padding="48,0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <StackPanel Spacing="0">
                    <TextBlock Text="AUDIT WORKSPACE" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Local security posture" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Height="32" Padding="14,0" Command="{x:Bind ViewModel.LoadDataCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Height="32" Padding="14,0" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunAuditCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="Run Audit" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Padding="48,12,48,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBox x:Name="SearchBox" PlaceholderText="Search issues..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="300" HorizontalAlignment="Left">
                <TextBox.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                        <Setter Property="Height" Value="32" />
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <ComboBox Grid.Column="1" Header="Category" PlaceholderText="Filter by category" SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.CategoryFilters}" MinWidth="180" Height="32" VerticalAlignment="Bottom" />
            <ComboBox Grid.Column="2" Header="Severity" PlaceholderText="Filter by severity" SelectedItem="{x:Bind ViewModel.SelectedSeverityFilter, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.SeverityFilters}" MinWidth="140" Height="32" VerticalAlignment="Bottom" />
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="2" Padding="48,16,48,24" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16" ColumnDefinitions="*,340" ColumnSpacing="16">
                <!-- Status Bar -->
                <InfoBar Grid.Row="0" Grid.ColumnSpan="2" IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="True" />

                <!-- Summary Cards -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <Border Padding="16,12" Style="{StaticResource LayerCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="TOTAL ISSUES" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="16,12" Style="{StaticResource LayerCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="HIGH" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.HighIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="#DC2626" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,12" Style="{StaticResource LayerCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="MEDIUM" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.MediumIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="#F59E0B" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="16,12" Style="{StaticResource LayerCardStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="LOW" Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LowIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Severity Chart -->
                <Border Grid.Row="1" Grid.Column="1" Padding="18,16" Style="{StaticResource LayerCardStyle}">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="SEVERITY DISTRIBUTION" Style="{StaticResource SectionLabelStyle}" />
                        <lvc:PieChart Grid.Row="1" Series="{x:Bind ViewModel.SeverityPieSeries, Mode=OneWay}" LegendPosition="Right" MinHeight="180" />
                    </Grid>
                </Border>

                <!-- Issue Groups -->
                <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{x:Bind ViewModel.IssueGroups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:IssueGroup">
                            <Border Padding="20,16" Margin="0,0,0,16" Style="{StaticResource LayerCardStyle}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="16">
                                    <!-- Group Header -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Border Width="36" Height="36" CornerRadius="18">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{x:Bind GroupColor}" Opacity="0.15" />
                                                </Border.Background>
                                                <TextBlock Text="{x:Bind GroupIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind GroupName}" Style="{StaticResource GroupHeaderStyle}" />
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                        <Run Text="Critical:" />
                                                        <Run Text="{x:Bind CriticalCount}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                        <Run Text="High:" />
                                                        <Run Text="{x:Bind HighCount}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                        <Run Text="Medium:" />
                                                        <Run Text="{x:Bind MediumCount}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12">
                                                        <Run Text="Low:" />
                                                        <Run Text="{x:Bind LowCount}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind TotalCount}" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Issues List -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Issues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AuditIssueEnhanced">
                                                <Border Padding="16,12" Margin="0,0,0,8" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" CornerRadius="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                                        <!-- Title Row -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="4" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{x:Bind SeverityBadgeColor}" />
                                                                </Border.Background>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <Border Grid.Column="2" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{x:Bind SeverityBadgeColor}" Opacity="0.2" />
                                                                </Border.Background>
                                                                <TextBlock Text="{x:Bind Severity}" FontSize="11" FontWeight="SemiBold">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{x:Bind SeverityBadgeColor}" />
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                                        <!-- Root Cause -->
                                                        <StackPanel Grid.Row="2" Spacing="4" Visibility="{x:Bind RootCause, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="ROOT CAUSE" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Text="{x:Bind RootCause}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <!-- Recommendation -->
                                                        <StackPanel Grid.Row="3" Spacing="4" Visibility="{x:Bind Recommendation, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="RECOMMENDATION" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                            <TextBlock Text="{x:Bind Recommendation}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="48" Style="{StaticResource LayerCardStyle}" Visibility="{x:Bind ViewModel.ShowEmptyIssues, Mode=OneWay}">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9CE;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No issues found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Run an audit to analyze system security events" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

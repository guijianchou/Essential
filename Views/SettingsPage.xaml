<Page
    x:Class="LocalSecurityAudit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    x:Name="PageRoot"
    Background="Transparent">
    <Grid Background="Transparent">
        <Grid.Resources>
            <Style x:Key="SettingsRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </Grid.Resources>
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="180"
                        AutomationProperties.Name="Settings sections"
            SelectionChanged="OnNavViewSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Appearance" Tag="appearance" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI" Tag="ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scanning" Tag="scanning">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Storage" Tag="storage">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="28,24,48,28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                    <InfoBar Grid.Row="0"
                             IsOpen="{x:Bind ViewModel.ShowOperationStatus, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.OperationSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}"
                             IsClosable="True"
                             Closed="OnInfoBarClosed" />

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="AppearancePage" Spacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Appearance" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Tune the window surface and color mode for your desktop." Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Reset" Command="{x:Bind ViewModel.ResetAppearanceSettingsCommand}" AutomationProperties.Name="Reset appearance settings" />
                                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="Save appearance settings" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Application theme" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Use the Windows preference or choose a fixed light or dark theme." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="150" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="System default" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Minimize to notification area" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Keep the audit service running when the window is closed. Restore or exit from the tray icon. Alert notifications can also keep the icon available." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="Minimize to notification area" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InsetWellStyle}" Padding="16,14">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MICA SURFACE" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock Text="This window uses the WinUI 3 Mica BaseAlt material. Transparent content layers keep the desktop tint visible behind cards and navigation." Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="AiPage" Spacing="16" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="AI configuration" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Choose the endpoint used to analyze local event logs." Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Reset" Command="{x:Bind ViewModel.ResetAiSettingsCommand}" AutomationProperties.Name="Reset AI settings" />
                                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="Save AI settings" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Button Content="Add target" Command="{x:Bind ViewModel.AddTargetCommand}" AutomationProperties.Name="Add AI target" />
                                <TextBlock Grid.Column="1" Text="Changes are applied to the next audit." Style="{StaticResource SecondaryTextStyle}" FontSize="12" VerticalAlignment="Center" Margin="4,0" />
                            </Grid>

                            <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="AGENTS.md audit policy" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="Plain-text rules sent to the AI as audit context. They are never executed by the app." Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Reset policy" Command="{x:Bind ViewModel.ResetAgentInstructionsCommand}" AutomationProperties.Name="Reset AGENTS.md audit policy" />
                                    </Grid>
                                    <TextBox Text="{x:Bind ViewModel.AgentInstructions, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="180"
                                             MaxHeight="300"
                                             MaxLength="16000"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="Describe evidence rules, severity guidance, and safe recommendations..."
                                             AutomationProperties.Name="AGENTS.md audit policy" />
                                    <TextBlock Text="{x:Bind ViewModel.AgentInstructionsPath, Mode=OneWay}"
                                               Style="{StaticResource MonoDetailStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="The policy is also saved as this local AGENTS.md file." />
                                </StackPanel>
                            </Border>

                            <ListView ItemsSource="{x:Bind ViewModel.AiTargets, Mode=OneWay}"
                                      SelectionMode="None"
                                      ItemContainerStyle="{StaticResource SettingsRowContainerStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AiTarget">
                                         <Expander Margin="0,0,0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                            <Expander.Header>
                                                <Grid Padding="0,6" ColumnDefinitions="8,*,Auto,Auto" ColumnSpacing="10">
                                                    <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Model, Mode=OneWay}" Style="{StaticResource NumericTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="ACTIVE" Style="{StaticResource MetaLabelStyle}" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind}" Click="OnRemoveTargetClicked" ToolTipService.ToolTip="Delete target">
                                                       <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Expander.Header>
                                            <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="96,*,Auto" ColumnSpacing="12" RowSpacing="10">
                                                    <TextBlock Text="NAME" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay}" PlaceholderText="Target name" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Use" Tag="{x:Bind}" Click="OnSetActiveTargetClicked" AutomationProperties.Name="Use this AI target" />
                                                        <Button Content="Test" Tag="{x:Bind}" Click="OnTestApiConnectionClicked" AutomationProperties.Name="Test AI target connection" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Row="1" Text="BASE URL" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind BaseUrl, Mode=TwoWay}" Style="{StaticResource MonoTextBoxStyle}" PlaceholderText="https://api.example.com" />
                                                    <TextBlock Grid.Row="2" Text="API KEY" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <PasswordBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" PlaceholderText="Enter API key" PasswordChanged="OnTargetPasswordChanged" />
                                                    <TextBlock Grid.Row="3" Text="MODE" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{x:Bind Mode, Mode=TwoWay, Converter={StaticResource ModeToIndexConverter}}">
                                                        <ComboBoxItem Content="chat" />
                                                        <ComboBoxItem Content="responses" />
                                                    </ComboBox>
                                                    <TextBlock Grid.Row="4" Text="MODEL" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{x:Bind Model, Mode=TwoWay, Converter={StaticResource ModelToIndexConverter}}">
                                                        <ComboBoxItem Content="gpt-5.6-sol" />
                                                        <ComboBoxItem Content="gpt-5.6-luna" />
                                                        <ComboBoxItem Content="gpt-5.6-terra" />
                                                    </ComboBox>
                                                    <TextBlock Grid.Row="5" Text="EFFORT" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="{x:Bind Effort, Mode=TwoWay, Converter={StaticResource EffortToIndexConverter}}">
                                                        <ComboBoxItem Content="low" />
                                                        <ComboBoxItem Content="medium" />
                                                        <ComboBoxItem Content="high" />
                                                        <ComboBoxItem Content="xhigh" />
                                                        <ComboBoxItem Content="max" />
                                                    </ComboBox>
                                                </Grid>
                                            </Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel x:Name="ScanningPage" Spacing="16" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Scanning" Style="{StaticResource PageTitleStyle}" />
                                    <TextBlock Text="Control when audits run and how much history a fast scan covers." Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Reset" Command="{x:Bind ViewModel.ResetScanningSettingsCommand}" AutomationProperties.Name="Reset scanning settings" />
                                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="Save scanning settings" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Automatic audits" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Run a background audit using the interval below." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoScanEnabled, Mode=TwoWay}" OnContent="" OffContent="" /></Grid></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Audit interval" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="The scheduler restarts immediately after saving." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" Width="150" SelectedIndex="{x:Bind ViewModel.ScanIntervalIndex, Mode=TwoWay}"><ComboBoxItem Content="Every hour" /><ComboBoxItem Content="Every 2 hours" /><ComboBoxItem Content="Every 4 hours" /><ComboBoxItem Content="Every 8 hours" /><ComboBoxItem Content="Daily" /></ComboBox></Grid></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Fast scan range" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Choose a fixed range or continue from the previous scan." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" Width="150" SelectedIndex="{x:Bind ViewModel.FastScanRangeIndex, Mode=TwoWay}"><ComboBoxItem Content="Past 1 hour" /><ComboBoxItem Content="Past 2 hours" /><ComboBoxItem Content="Past 4 hours" /><ComboBoxItem Content="Since last scan" /></ComboBox></Grid></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="High-severity alerts" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Keep the preference ready for the notification channel." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HighSeverityNotification, Mode=TwoWay}" OnContent="" OffContent="" /></Grid></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Completion alerts" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Show a notification when an audit completes." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ScanCompleteNotification, Mode=TwoWay}" OnContent="" OffContent="" /></Grid></Border>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Diagnostic logging" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Record scan timings, request status, retries and exception details for troubleshooting. API keys, event text and request bodies are excluded." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DiagnosticLoggingEnabled, Mode=TwoWay}" OnContent="" OffContent="" AutomationProperties.Name="Enable diagnostic logging" /></Grid></Border>
                            <Border Style="{StaticResource InsetWellStyle}" Padding="16,14"><StackPanel Spacing="5"><TextBlock Text="DIAGNOSTIC LOG FILE" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.DiagnosticLogPath, Mode=OneWay}" Style="{StaticResource MonoDetailStyle}" TextWrapping="Wrap" /></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="StoragePage" Spacing="16" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Storage" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="Manage local audit history without touching the live scanner." Style="{StaticResource SecondaryTextStyle}" FontSize="12" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Clean old data" Command="{x:Bind ViewModel.CleanupDataCommand}" /><Button Content="Optimize" Command="{x:Bind ViewModel.VacuumDatabaseCommand}" /></StackPanel></Grid>
                            <Border Style="{StaticResource SettingsCardStyle}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="Retention period" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="Records older than this are removed by cleanup and after a scan." FontSize="12" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel><ComboBox Grid.Column="1" Width="150" SelectedIndex="{x:Bind ViewModel.RetentionDaysIndex, Mode=TwoWay}"><ComboBoxItem Content="3 days" /><ComboBoxItem Content="7 days" /><ComboBoxItem Content="14 days" /><ComboBoxItem Content="30 days" /></ComboBox></Grid></Border>
                            <Border Style="{StaticResource InsetWellStyle}" Padding="16,14"><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="4"><TextBlock Text="DATABASE SIZE" Style="{StaticResource MetaLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.DatabaseSize, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="AUDIT RECORDS" Style="{StaticResource MetaLabelStyle}" /><TextBlock Text="{x:Bind ViewModel.AuditRecordCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" /></StackPanel></Grid></Border>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Spacing="16" Visibility="Collapsed">
                            <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Image Width="42" Height="42" Source="ms-appx:///Assets/logo-48.png" VerticalAlignment="Top" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Local Security Audit" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Version 0.1.0" Style="{StaticResource SecondaryTextStyle}" FontSize="12" /><TextBlock Text="A local Windows event-log audit workspace built with WinUI 3, Mica and SQLite." Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource InsetWellStyle}" Padding="16,14"><StackPanel Spacing="6"><TextBlock Text="DATA &amp; PRIVACY" Style="{StaticResource SectionLabelStyle}" /><TextBlock Text="Audit records are stored locally. AI analysis sends selected event summaries to the configured endpoint only when an audit runs." Style="{StaticResource SecondaryTextStyle}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Page>

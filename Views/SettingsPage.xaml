<Page
    x:Class="LocalSecurityAudit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    x:Name="PageRoot"
    Background="Transparent">
    <Grid Background="Transparent" RowDefinitions="Auto,*">
        <Grid.Resources>
            <Style x:Key="SettingsRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style x:Key="SettingTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}" />
            <Style x:Key="SettingDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
            </Style>
            <Style x:Key="FormLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySmallTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Padding="32,18,32,4">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding [Settings], Source={StaticResource AppText}}" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="{Binding [Changesapplytothenextauditafteryousave], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        Margin="20,0,0,0"
                        PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AutomationProperties.Name="{Binding [Settingssections], Source={StaticResource AppText}}"
                        SelectionChanged="OnNavViewSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{Binding [Appearance], Source={StaticResource AppText}}" Tag="appearance" IsSelected="True" />
                <NavigationViewItem Content="{Binding [AIanalysis], Source={StaticResource AppText}}" Tag="ai" />
                <NavigationViewItem Content="{Binding [Scanning], Source={StaticResource AppText}}" Tag="scanning" />
                <NavigationViewItem Content="{Binding [Storage], Source={StaticResource AppText}}" Tag="storage" />
                <NavigationViewItem Content="{Binding [About], Source={StaticResource AppText}}" Tag="about" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="12,12,32,28" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <InfoBar IsOpen="{x:Bind ViewModel.ShowOperationStatus, Mode=TwoWay}"
                             Severity="{x:Bind ViewModel.OperationSeverity, Mode=OneWay}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}"
                             IsClosable="True"
                             Closed="OnInfoBarClosed" />

                    <Grid>
                        <!-- Appearance -->
                        <StackPanel x:Name="AppearancePage" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Appearance], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                                    <TextBlock Text="{Binding [Windowsurfaceandcolormode], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding [Reset], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.ResetAppearanceSettingsCommand}" AutomationProperties.Name="{Binding [Resetappearancesettings], Source={StaticResource AppText}}" />
                                    <Button Content="{Binding [Save], Source={StaticResource AppText}}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="{Binding [Saveappearancesettings], Source={StaticResource AppText}}" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Text="{Binding [Language], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="180" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding [Language], Source={StaticResource AppText}}">
                                        <ComboBoxItem Content="{Binding [English], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="&#x7B80;&#x4F53;&#x4E2D;&#x6587;" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Applicationtheme], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [FollowtheWindowspreferenceorchooseafixedlightordarktheme], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{Binding [Systemdefault], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Light], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Dark], Source={StaticResource AppText}}" />
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Minimizetothenotificationarea], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [KeeptheauditservicerunningwhenthewindowisclosedRestoreorexitfromthetrayicon], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding [Minimizetothenotificationarea], Source={StaticResource AppText}}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- AI analysis -->
                        <StackPanel x:Name="AiPage" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [AIanalysis], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                                    <TextBlock Text="{Binding [LunareadseachbatchofeventsandreturnsfindingsinafixedJSONcontractOnlyLunaissupportedatthemoment], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding [Reset], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.ResetAiSettingsCommand}" AutomationProperties.Name="{Binding [ResetAIsettings], Source={StaticResource AppText}}" />
                                    <Button Content="{Binding [Save], Source={StaticResource AppText}}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="{Binding [SaveAIsettings], Source={StaticResource AppText}}" />
                                </StackPanel>
                            </Grid>

                            <!-- Request pipeline -->
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding [Requestpipeline], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ActiveTargetSummary, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding [Collect], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.PipelineCollectText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="{Binding [Batch], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.PipelineBatchText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="3" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="4" Spacing="4">
                                            <TextBlock Text="{Binding [Analyze], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.PipelineAnalyzeText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="5" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="6" Spacing="4">
                                            <TextBlock Text="{Binding [Parse], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.PipelineParseText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="7" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="8" Spacing="4">
                                            <TextBlock Text="{Binding [Store], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.PipelineStoreText, Mode=OneWay}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Audit policy -->
                            <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding [Auditpolicy], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                            <TextBlock Text="{Binding [PlaintextrulessenttoLunawitheverybatchevidencerulesseverityrubriccategorytaxonomyandtheJSONoutputcontractTheappneverexecutesthem], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                                            <TextBlock Text="{x:Bind ViewModel.PolicyStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                            <Button Content="{Binding [Resetpolicy], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.ResetAgentInstructionsCommand}" AutomationProperties.Name="{Binding [Resetauditpolicy], Source={StaticResource AppText}}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox Text="{x:Bind ViewModel.AgentInstructions, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="240"
                                             MaxHeight="420"
                                             MaxLength="32000"
                                             FontSize="13"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             PlaceholderText="{Binding [Describeevidencerulesseverityguidanceandtheoutputcontract], Source={StaticResource AppText}}"
                                             AutomationProperties.Name="{Binding [Auditpolicy], Source={StaticResource AppText}}" />
                                    <TextBlock Style="{StaticResource CaptionTextStyle}" ToolTipService.ToolTip="{Binding [ThepolicyisalsosavedasthislocalAGENTSmdfile], Source={StaticResource AppText}}">
                                        <Run Text="{Binding [Alsosavedas], Source={StaticResource AppText}}" /><Run Text="{x:Bind ViewModel.AgentInstructionsPath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Endpoints -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,6,0,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Endpoints], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                     <TextBlock Text="{Binding [MainreceivesrequestsfirstAnoptionalFallbackisusedonlyafterMainfailsleaveitsURLemptytodisableit], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                 </StackPanel>
                             </Grid>

                            <ListView ItemsSource="{x:Bind ViewModel.AiTargets, Mode=OneWay}"
                                      SelectionMode="None"
                                      ItemContainerStyle="{StaticResource SettingsRowContainerStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AiTarget">
                                        <Expander Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Name}">
                                            <Expander.Header>
                                                <Grid Padding="0,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" />
                                                        <TextBlock Text="{x:Bind BaseUrl, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                                    </StackPanel>
                                                     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                         <TextBlock Text="{x:Bind Effort, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                                         <TextBlock Text="{Binding [Mainfirst], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                         <TextBlock Text="{Binding [Optionalfallback], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Expander.Header>
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="128,*" ColumnSpacing="14" RowSpacing="10" Padding="4,6,4,4">
                                                <TextBlock Grid.Row="0" Text="{Binding [Name], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                 <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" IsReadOnly="True" />

                                                <TextBlock Grid.Row="1" Text="{Binding [EndpointURL], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind BaseUrl, Mode=TwoWay}" PlaceholderText="https://api.example.com" />

                                                <TextBlock Grid.Row="2" Text="{Binding [APIkey], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                <PasswordBox Grid.Row="2" Grid.Column="1" PlaceholderText="{Binding [EnterorpastetheAPIkey], Source={StaticResource AppText}}" PasswordChanged="OnTargetPasswordChanged" />

                                                <TextBlock Grid.Row="3" Text="{Binding [APImode], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="260" SelectedIndex="{x:Bind Mode, Mode=TwoWay, Converter={StaticResource ModeToIndexConverter}}">
                                                    <ComboBoxItem Content="chat (/v1/chat/completions)" />
                                                    <ComboBoxItem Content="responses (/v1/responses)" />
                                                </ComboBox>

                                                <TextBlock Grid.Row="4" Text="{Binding [Model], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                                                    <ComboBox MinWidth="260" SelectedIndex="{x:Bind Model, Mode=TwoWay, Converter={StaticResource ModelToIndexConverter}}">
                                                        <ComboBoxItem Content="{Binding [gpt56lunaLuna256kcontext], Source={StaticResource AppText}}" />
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding [OnlyLunaissupportedatthemomentBatchsizesandthecontextbudgetaretunedforit], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="5" Text="{Binding [Reasoningeffort], Source={StaticResource AppText}}" Style="{StaticResource FormLabelStyle}" />
                                                <ComboBox Grid.Row="5" Grid.Column="1" MinWidth="260" SelectedIndex="{x:Bind Effort, Mode=TwoWay, Converter={StaticResource EffortToIndexConverter}}">
                                                    <ComboBoxItem Content="{Binding [low], Source={StaticResource AppText}}" />
                                                    <ComboBoxItem Content="{Binding [medium], Source={StaticResource AppText}}" />
                                                    <ComboBoxItem Content="{Binding [high], Source={StaticResource AppText}}" />
                                                    <ComboBoxItem Content="{Binding [xhigh], Source={StaticResource AppText}}" />
                                                    <ComboBoxItem Content="{Binding [max], Source={StaticResource AppText}}" />
                                                </ComboBox>

                                                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                                     <Button Content="{Binding [Testconnection], Source={StaticResource AppText}}" Tag="{x:Bind}" Click="OnTestApiConnectionClicked" AutomationProperties.Name="{Binding [Testconnection], Source={StaticResource AppText}}" />
                                                     <Button Content="{Binding [Clearfallback], Source={StaticResource AppText}}" Tag="{x:Bind}" Click="OnRemoveTargetClicked" AutomationProperties.Name="{Binding [Clearfallback], Source={StaticResource AppText}}" Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Scanning -->
                        <StackPanel x:Name="ScanningPage" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Scanning], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                                    <TextBlock Text="{Binding [Whenauditsrunandhowmuchhistoryafastscancovers], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding [Reset], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.ResetScanningSettingsCommand}" AutomationProperties.Name="{Binding [Resetscanningsettings], Source={StaticResource AppText}}" />
                                    <Button Content="{Binding [Save], Source={StaticResource AppText}}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="{Binding [Savescanningsettings], Source={StaticResource AppText}}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Automaticaudits], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Runabackgroundauditattheintervalbelow], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoScanEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding [Automaticaudits], Source={StaticResource AppText}}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Auditinterval], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Theschedulerrestartsassoonasyousave], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.ScanIntervalIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{Binding [Everyhour], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Every2hours], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Every4hours], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Every8hours], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Daily], Source={StaticResource AppText}}" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Fastscanrange], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Afixedrangeoreverythingsincethepreviousscan], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.FastScanRangeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{Binding [Pasthour], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Past2hours], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Past4hours], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [Sincelastscan], Source={StaticResource AppText}}" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Highseverityalerts], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Showanotificationwhenanauditreportsahighfinding], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.HighSeverityNotification, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding [Highseverityalerts], Source={StaticResource AppText}}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Completionalerts], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Showanotificationwhenanauditcompletes], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.ScanCompleteNotification, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding [Completionalerts], Source={StaticResource AppText}}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Diagnosticlogging], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [RecordscantimingsrequeststatusretriesandexceptionsAPIkeyseventtextandrequestbodiesareneverwritten], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.DiagnosticLogPath, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.DiagnosticLoggingEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" AutomationProperties.Name="{Binding [Diagnosticlogging], Source={StaticResource AppText}}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Storage -->
                        <StackPanel x:Name="StoragePage" Spacing="12" Visibility="Collapsed">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Storage], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                                    <TextBlock Text="{Binding [LocalaudithistoryNothingheretouchesthelivescanner], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding [Cleanolddata], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.CleanupDataCommand}" />
                                    <Button Content="{Binding [Optimizedatabase], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.VacuumDatabaseCommand}" />
                                    <Button Content="{Binding [Save], Source={StaticResource AppText}}" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveSettingsCommand}" AutomationProperties.Name="{Binding [Savestoragesettings], Source={StaticResource AppText}}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Retentionperiod], Source={StaticResource AppText}}" Style="{StaticResource SettingTitleStyle}" />
                                        <TextBlock Text="{Binding [Recordsolderthanthisareremovedbycleanupandaftereachscan], Source={StaticResource AppText}}" Style="{StaticResource SettingDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="160" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.RetentionDaysIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="{Binding [3days], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [7days], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [14days], Source={StaticResource AppText}}" />
                                        <ComboBoxItem Content="{Binding [30days], Source={StaticResource AppText}}" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <Border Style="{StaticResource TileStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding [Databasesize], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.DatabaseSize, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource TileStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding [Auditrecords], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.AuditRecordCount, Mode=OneWay}" Style="{StaticResource StatValueStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- About -->
                        <StackPanel x:Name="AboutPage" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="{Binding [About], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

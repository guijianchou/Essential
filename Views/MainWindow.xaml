<Window
    x:Class="LocalSecurityAudit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    Title="Local Security Audit">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root"
          Loaded="OnLoaded"
          Background="Transparent"
          RowDefinitions="32,*">
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Padding="12,0,138,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/logo-32.png" />
                <TextBlock Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="AppNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
                        OpenPaneLength="264"
                        CompactPaneLength="48"
                        SizeChanged="OnNavigationSizeChanged"
                        PaneOpening="OnPaneOpening"
                        ItemInvoked="NavigationView_ItemInvoked">
            <NavigationView.PaneHeader>
                <Grid Height="40" Margin="16,4,0,8">
                    <TextBlock Text="{x:Bind ViewModel.ModeText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{Binding [Dashboard], Source={StaticResource AppText}}" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{Binding [Trends], Source={StaticResource AppText}}" Tag="trends">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="WorkflowHeader"
                                          Visibility="{Binding IsWorkflowVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid x:Name="WorkflowHost" RowDefinitions="*,Auto,*" Padding="8,0"
                          Visibility="{Binding IsWorkflowVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid x:Name="WorkflowContent" Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto"
                              Padding="0,0,0,8">
                            <Grid>
                                <StackPanel x:Name="WorkflowHeading" Margin="8,8,8,8" Spacing="4"
                                            Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Height="20" ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                                        <FontIcon x:Name="WorkflowStatusIcon" Glyph="{x:Bind ViewModel.WorkflowGlyph, Mode=OneWay}" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkflowTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.WorkflowTooltip, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WorkflowPercentText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar x:Name="WorkflowProgress" Value="{x:Bind ViewModel.WorkflowPercent, Mode=OneWay}" Minimum="0" Maximum="100" Height="4"
                                                 AutomationProperties.Name="{x:Bind ViewModel.WorkflowProgressLabel, Mode=OneWay}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.WorkflowProgressLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WorkflowCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,8,0,8"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.WorkflowTooltip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind ViewModel.WorkflowTooltip, Mode=OneWay}"
                                            Visibility="{Binding IsPaneOpen, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <FontIcon x:Name="CompactWorkflowStatusIcon" Glyph="{x:Bind ViewModel.WorkflowGlyph, Mode=OneWay}" FontSize="14" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkflowPercentText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="WorkflowSteps" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Steps}"
                                      SelectedItem="{x:Bind ViewModel.SelectedStep, Mode=TwoWay}" SelectionMode="Single"
                                      IsItemClickEnabled="True" ItemClick="OnWorkflowStepClick" Padding="0" Height="216"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="{Binding [Scanstages], Source={StaticResource AppText}}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="4,0" />
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScanStep">
                                        <Grid ColumnDefinitions="40,*" Height="{x:Bind RowHeight, Mode=OneWay}"
                                              Loaded="OnScanStepLoaded" Unloaded="OnScanStepUnloaded"
                                              AutomationProperties.Name="{x:Bind Tooltip, Mode=OneWay}"
                                              ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                            <Grid Width="24" Height="24" VerticalAlignment="Center">
                                                <ProgressRing x:Name="ActiveRing" Width="20" Height="20" IsActive="False"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <FontIcon x:Name="StaticActiveIcon" Glyph="&#xE895;" FontSize="16"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                                                <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource HealthGoodBrush}"
                                                          Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource HealthRiskBrush}"
                                                          Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <FontIcon Glyph="{x:Bind InactiveGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                          Visibility="{Binding IsInactive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                            <Grid x:Name="StepText" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock x:Name="StepTitle" Text="{x:Bind Title, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="StepStatus" Grid.Column="1" Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid x:Name="WorkflowSummary" Grid.Row="2" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="8,8,8,4"
                                  BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,0"
                                  Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.SelectedStep.Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="StepDetailsScroll" Grid.Row="1" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedStep.Detail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ScrollViewer>
                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                      Visibility="{Binding SelectedStep.HasBatchProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressBar x:Name="SelectedStepProgress" Value="{x:Bind ViewModel.SelectedStep.Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="3" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedStep.BatchText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Row="3" Margin="8,6,8,0"
                                        Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource HealthGoodBrush}"
                                           Visibility="{Binding HasSavedResult, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </NavigationViewItemHeader>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="pane" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PaneToggleText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.PaneToggleText, Mode=OneWay}">
                    <NavigationViewItem.Icon><FontIcon Glyph="{x:Bind ViewModel.PaneToggleGlyph, Mode=OneWay}" FontSize="16" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Margin="0" NavigationFailed="ContentFrame_NavigationFailed" />
        </NavigationView>
    </Grid>
</Window>

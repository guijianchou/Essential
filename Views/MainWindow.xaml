<Window
    x:Class="LocalSecurityAudit.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    Title="Local Security Audit">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root"
          Loaded="OnLoaded"
          Background="Transparent"
          RowDefinitions="32,*">
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Padding="12,0,138,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Image Width="16" Height="16" Source="ms-appx:///Assets/logo-32.png" />
                <TextBlock Text="{Binding [LocalSecurityAudit], Source={StaticResource AppText}}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="AppNavigation"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="True"
                        IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
                        OpenPaneLength="264"
                        CompactPaneLength="48"
                        SizeChanged="OnNavigationSizeChanged"
                        PaneOpening="OnPaneOpening"
                        ItemInvoked="NavigationView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{Binding [Dashboard], Source={StaticResource AppText}}" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{Binding [Trends], Source={StaticResource AppText}}" Tag="trends">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <Grid x:Name="WorkflowHost" RowDefinitions="Auto,*,Auto" Padding="0,12,0,8">
                    <TextBlock x:Name="WorkflowHeading" Text="{x:Bind ViewModel.WorkflowTitle, Mode=OneWay}" Margin="20,0,16,14"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScanStep">
                                    <Grid ColumnDefinitions="48,*" Height="{x:Bind RowHeight, Mode=OneWay}"
                                          Loaded="OnScanStepLoaded" Unloaded="OnScanStepUnloaded"
                                          AutomationProperties.Name="{x:Bind Tooltip, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                        <Grid.Transitions>
                                            <TransitionCollection>
                                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                                            </TransitionCollection>
                                        </Grid.Transitions>
                                        <Rectangle Width="2" Margin="0,28,0,0" Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                                   Visibility="{Binding HasConnector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Rectangle Width="2" Margin="0,28,0,0" Fill="{ThemeResource HealthGoodBrush}"
                                                   Visibility="{Binding HasCompletedConnector, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Grid Width="24" Height="24" VerticalAlignment="Top">
                                            <ProgressRing x:Name="ActiveRing" Width="20" Height="20" IsActive="False"
                                                          Foreground="{ThemeResource HealthWarningBrush}"
                                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon x:Name="StaticActiveIcon" Glyph="&#xE895;" FontSize="16"
                                                      Foreground="{ThemeResource HealthWarningBrush}" Visibility="Collapsed" />
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource HealthGoodBrush}"
                                                      Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="&#xEA39;" FontSize="16" Foreground="{ThemeResource HealthRiskBrush}"
                                                      Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <FontIcon Glyph="{x:Bind InactiveGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      Visibility="{Binding IsInactive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <StackPanel x:Name="StepText" Grid.Column="1" Spacing="4" Margin="0,2,20,12"
                                                    Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Spacing="5" Visibility="{Binding HasBatchProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="100" Height="3"
                                                             Foreground="{ThemeResource HealthGoodBrush}" />
                                                <TextBlock Text="{x:Bind BatchText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="WorkflowSummary" Grid.Row="2" Margin="20,10,16,0" Spacing="4"
                                Visibility="{Binding IsPaneOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding [EnglishSimplifiedChinese], Source={StaticResource AppText}}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SavedText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource HealthGoodBrush}"
                                   Visibility="{Binding HasSavedResult, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="toggle-pane" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PaneToggleText, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind ViewModel.PaneToggleText, Mode=OneWay}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{x:Bind ViewModel.PaneToggleGlyph, Mode=OneWay}" FontSize="14" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Margin="0" NavigationFailed="ContentFrame_NavigationFailed" />
        </NavigationView>
    </Grid>
</Window>

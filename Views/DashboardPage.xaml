<Page
    x:Class="LocalSecurityAudit.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    Background="Transparent">
    <Grid Background="Transparent" RowDefinitions="Auto,*">
        <!-- Page header -->
        <Grid Grid.Row="0" Padding="32,18,32,8" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Dashboard], Source={StaticResource AppText}}" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.LastAuditHeadline, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Height="32" Padding="12,0" Command="{x:Bind ViewModel.RunFastScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="{Binding [Runfastscan], Source={StaticResource AppText}}" ToolTipService.ToolTip="{Binding [Scaneventssincethelastaudit], Source={StaticResource AppText}}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8FE;" FontSize="12" />
                        <TextBlock Text="{Binding [Fastscan], Source={StaticResource AppText}}" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Height="32" Padding="12,0" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunFullScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="{Binding [Runfullscan], Source={StaticResource AppText}}" ToolTipService.ToolTip="{Binding [Scanthepast24hours], Source={StaticResource AppText}}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="{Binding [Fullscan], Source={StaticResource AppText}}" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,32"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         Closed="OnStatusBarClosed" />

                <!-- Health score and latest audit -->
                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
                    <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding [Healthscore], Source={StaticResource AppText}}">
                        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                            <TextBlock Text="{Binding [Healthscore], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                <TextBlock x:Name="HealthScoreText"
                                           Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}"
                                           Style="{StaticResource HeroNumberStyle}"
                                           AutomationProperties.Name="{Binding [Currenthealthscore], Source={StaticResource AppText}}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                    <Ellipse x:Name="HealthDot" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.HealthVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Grid x:Name="HealthMeter" Grid.Row="2" Height="8" AutomationProperties.Name="{Binding [Healthmeter], Source={StaticResource AppText}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HealthMeterFillColumn" Width="0*" />
                                    <ColumnDefinition x:Name="HealthMeterRestColumn" Width="100*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="{ThemeResource MeterTrackBrush}" CornerRadius="4" />
                                <Border x:Name="HealthMeterFill" CornerRadius="4" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Row="3" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.HealthDeductionText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding [Latestaudit], Source={StaticResource AppText}}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <TextBlock Text="{Binding [Latestaudit], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="9" VerticalAlignment="Top">
                                <TextBlock Grid.Row="0" Text="{Binding [Scan], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ScanTypeText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="{Binding [Finished], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FinishedText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Text="{Binding [Window], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="3" Text="{Binding [Eventsread], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextAlignment="Right" TextWrapping="NoWrap" />
                                <TextBlock Grid.Row="4" Text="{Binding [Scansstored], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ScanCountText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextAlignment="Right" TextWrapping="NoWrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Findings by category -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton Tag="All" Content="{x:Bind ViewModel.OverviewLabel, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="4"
                                      IsChecked="{x:Bind ViewModel.IsSourceAll, Mode=OneWay}" Click="OnSourceFilterClick" />
                        <ToggleButton Tag="Application" Content="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="4"
                                      IsChecked="{x:Bind ViewModel.IsSourceApplication, Mode=OneWay}" Click="OnSourceFilterClick" />
                        <ToggleButton Tag="Security" Content="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="4"
                                      IsChecked="{x:Bind ViewModel.IsSourceSecurity, Mode=OneWay}" Click="OnSourceFilterClick" />
                        <ToggleButton Tag="Setup" Content="{x:Bind ViewModel.SetupLabel, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="4"
                                      IsChecked="{x:Bind ViewModel.IsSourceSetup, Mode=OneWay}" Click="OnSourceFilterClick" />
                        <ToggleButton Tag="System" Content="{x:Bind ViewModel.SystemLabel, Mode=OneWay}" Height="32" Padding="12,0" CornerRadius="4"
                                      IsChecked="{x:Bind ViewModel.IsSourceSystem, Mode=OneWay}" Click="OnSourceFilterClick" />
                    </StackPanel>
                </ScrollViewer>
                <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding [Findings], Source={StaticResource AppText}}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Findings], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FindingsSummaryText, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton Tag="All" Height="30" Padding="12,0" CornerRadius="15" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}" AutomationProperties.Name="{Binding [Showallfindings], Source={StaticResource AppText}}">
                                    <TextBlock FontSize="12"><Run Text="{Binding [All], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.TotalFindings, Mode=OneWay}" /></TextBlock>
                                </ToggleButton>
                                <ToggleButton Tag="High" Height="30" Padding="12,0" CornerRadius="15" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterHigh, Mode=OneWay}" AutomationProperties.Name="{Binding [Showhighfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityHighFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [High], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.HighCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Tag="Medium" Height="30" Padding="12,0" CornerRadius="15" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterMedium, Mode=OneWay}" AutomationProperties.Name="{Binding [Showmediumfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityMediumFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [Medium], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Tag="Low" Height="30" Padding="12,0" CornerRadius="15" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterLow, Mode=OneWay}" AutomationProperties.Name="{Binding [Showlowfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityLowFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [Low], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Priorityfindings], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                    <TextBlock Text="{Binding [Startherehighestseveritymostrepeatedandnewestevidence], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding [Top5], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PriorityFindings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AuditIssueEnhanced">
                                        <Button Tag="{x:Bind}"
                                                Click="OnFindingClick"
                                                Margin="0,0,0,8"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding [Openfindingdetails], Source={StaticResource AppText}}"
                                                ToolTipService.ToolTip="{Binding [Openfindingdetails], Source={StaticResource AppText}}">
                                            <Border Style="{StaticResource FindingCardStyle}" Padding="14,12">
                                                <Grid ColumnDefinitions="4,*">
                                                    <Border Grid.Column="0" Background="{ThemeResource SeverityHighFillBrush}" CornerRadius="4" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Grid.Column="0" Background="{ThemeResource SeverityMediumFillBrush}" CornerRadius="4" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Grid.Column="0" Background="{ThemeResource SeverityLowFillBrush}" CornerRadius="4" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <StackPanel Grid.Column="1" Spacing="5" Padding="10,0,0,0">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{x:Bind SeverityText}" Style="{StaticResource CaptionStrongTextStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind CategoryLabel}" Style="{StaticResource CaptionTextStyle}" />
                                                            <TextBlock Grid.Column="2" Text="{x:Bind EventTimestampText}" Style="{StaticResource CaptionTextStyle}" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                            <TextBlock Text="{Binding [Why], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind PriorityReasonText}" Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="1" Text="{Binding [Action], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind PriorityActionText}" Style="{StaticResource BodySmallTextStyle}" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Row="2" Text="{Binding [Evidence], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind EvidenceSummaryText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource InsetWellStyle}" Padding="12,10" AutomationProperties.Name="{Binding [Auditcoverage], Source={StaticResource AppText}}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.CoverageState, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CoverageText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.FindingSections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FindingSection">
                                    <Expander Margin="0,0,0,8"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Name}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18" Padding="0,10" HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextStyle}" />
                                                    <TextBlock Text="{x:Bind SeveritySummary}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Border Width="{x:Bind HighBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityHighFillBrush}" Visibility="{x:Bind HasHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Width="{x:Bind MediumBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityMediumFillBrush}" Visibility="{x:Bind HasMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Width="{x:Bind LowBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityLowFillBrush}" Visibility="{x:Bind HasLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" Style="{StaticResource CaptionTextStyle}" MinWidth="76" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{x:Bind Issues}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AuditIssueEnhanced">
                                                    <Button Tag="{x:Bind}"
                                                            Click="OnFindingClick"
                                                            Margin="0,0,0,8"
                                                            Padding="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.Name="{Binding [Openfindingdetails], Source={StaticResource AppText}}"
                                                            ToolTipService.ToolTip="{Binding [Openfindingdetails], Source={StaticResource AppText}}">
                                                        <Border Style="{StaticResource FindingCardStyle}">
                                                            <Grid ColumnDefinitions="4,*">
                                                                <Border CornerRadius="5,0,0,5" Background="{ThemeResource SeverityHighFillBrush}" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <Border CornerRadius="5,0,0,5" Background="{ThemeResource SeverityMediumFillBrush}" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <Border CornerRadius="5,0,0,5" Background="{ThemeResource SeverityLowFillBrush}" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                <StackPanel Grid.Column="1" Spacing="6" Padding="14,12,16,12">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                        <TextBlock Text="{Binding [High], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityHighTextBrush}" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Text="{Binding [Medium], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityMediumTextBrush}" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Text="{Binding [Low], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityLowTextBrush}" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind EventIdLabel}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind HasEventId, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind EventTimestampText}" Style="{StaticResource CaptionTextStyle}" />
                                                                    </Grid>
                                                                    <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                                                                    <TextBlock Text="{x:Bind DisplayDescription}" Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasDisplayDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <Grid ColumnDefinitions="52,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4" Margin="0,2,0,0">
                                                                        <TextBlock Grid.Row="0" Text="{Binding [Cause], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" Visibility="{x:Bind HasRootCause, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind RootCause}" Style="{StaticResource BodySmallTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasRootCause, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Grid.Row="1" Text="{Binding [Action], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" Visibility="{x:Bind HasRecommendation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Recommendation}" Style="{StaticResource BodySmallTextStyle}" Visibility="{x:Bind HasRecommendation, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,2,0,0">
                                                                        <TextBlock Text="{x:Bind OccurrencesLabel}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind HasOccurrences, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Text="{x:Bind ConfidenceLabel}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind HasConfidence, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                        <TextBlock Text="{x:Bind Affected}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind HasAffected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Padding="0,28" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoAudit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Noaudityet], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Runafastscantocheckrecenteventsorafullscanforthepast24hours], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Padding="0,28" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowEmptyIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE73E;" FontSize="26" Foreground="{ThemeResource HealthGoodBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Nofindingsinthelatestaudit], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Thescannedeventsdidnotproduceanythingtoreview], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Padding="0,20" Spacing="4" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoFilterMatches, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding [Nothingatthisseverity], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Chooseanotherseverityorshowallfindings], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<Page
    x:Class="LocalSecurityAudit.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="FindingPreviewTemplate" x:DataType="models:AuditIssueEnhanced">
            <Button Tag="{x:Bind}" Click="OnFindingClick" Margin="0,0,0,8" Padding="12,10" CornerRadius="6"
                    Background="{ThemeResource FindingCardBackgroundBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind DisplayTitle}"
                    AutomationProperties.HelpText="{Binding [Openfindingdetails], Source={StaticResource AppText}}"
                    ToolTipService.ToolTip="{Binding [Openfindingdetails], Source={StaticResource AppText}}">
                <Grid ColumnDefinitions="3,*,Auto" ColumnSpacing="12">
                    <Border Background="{ThemeResource SeverityHighFillBrush}" CornerRadius="2" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Background="{ThemeResource SeverityMediumFillBrush}" CornerRadius="2" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Border Background="{ThemeResource SeverityLowFillBrush}" CornerRadius="2" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Grid.Column="1" Spacing="5">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Text="{x:Bind SeverityText}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityHighTextBrush}" Visibility="{x:Bind IsHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind SeverityText}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityMediumTextBrush}" Visibility="{x:Bind IsMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind SeverityText}" Style="{StaticResource CaptionStrongTextStyle}" Foreground="{ThemeResource SeverityLowTextBrush}" Visibility="{x:Bind IsLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind CategoryLabel}" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ModelLabel}" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                        <TextBlock Text="{x:Bind DisplayTitle}" Style="{StaticResource BodyStrongTextStyle}" FontSize="13"
                                   TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind DisplayTitle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="{Binding [Action], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PriorityActionText}" Style="{StaticResource BodySmallTextStyle}"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind PriorityActionText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="{x:Bind EvidenceSummaryText}" Style="{StaticResource CaptionTextStyle}" ToolTipService.ToolTip="{x:Bind EvidenceSummaryText}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind OccurrencesLabel}" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind HasOccurrences, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind EventTimestampText}" Style="{StaticResource CaptionTextStyle}" />
                        </Grid>
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>
    <Grid Background="Transparent" RowDefinitions="Auto,*">
        <!-- Page header -->
        <Grid Grid.Row="0" Padding="32,18,32,8" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding [Dashboard], Source={StaticResource AppText}}" Style="{StaticResource SubtitleTextStyle}" />
                <TextBlock Text="{x:Bind ViewModel.LastAuditHeadline, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{Binding [Refreshresults], Source={StaticResource AppText}}" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.LoadDataCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                    Visibility="{x:Bind ViewModel.IsAssistantMode, Converter={StaticResource BoolToVisibilityConverter}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsExtendedMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Height="32" Padding="12,0" Command="{x:Bind ViewModel.RunFastScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="{Binding [Runfastscan], Source={StaticResource AppText}}" ToolTipService.ToolTip="{Binding [Scanrecenteventsusingtheconfiguredtimerange], Source={StaticResource AppText}}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8FE;" FontSize="12" />
                        <TextBlock Text="{Binding [Fastscan], Source={StaticResource AppText}}" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Height="32" Padding="12,0" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunFullScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="{Binding [Runfullscan], Source={StaticResource AppText}}" ToolTipService.ToolTip="{x:Bind ViewModel.FullScanRangeHint, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="{Binding [Fullscan], Source={StaticResource AppText}}" FontSize="13" />
                    </StackPanel>
                </Button>
                <ComboBox Width="76" Height="32" SelectedIndex="{x:Bind ViewModel.FullScanRangeIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                          AutomationProperties.Name="{Binding [Fullscanrange], Source={StaticResource AppText}}"
                          ToolTipService.ToolTip="{x:Bind ViewModel.FullScanRangeHint, Mode=OneWay}">
                    <ComboBoxItem Content="1d" />
                    <ComboBoxItem Content="2d" />
                    <ComboBoxItem Content="1w" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,32"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.ScopeHint, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         Closed="OnStatusBarClosed" />

                <!-- One overview surface; period totals and the selected audit remain explicitly labelled. -->
                <Border Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding [Healthoverview], Source={StaticResource AppText}}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding [Healthoverview], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{ThemeResource ControlFillColorTertiaryBrush}" CornerRadius="6" Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <ToggleButton Tag="0" Content="{Binding [All], Source={StaticResource AppText}}" IsChecked="{x:Bind ViewModel.IsRangeAll, Mode=OneWay}" Click="OnActivityRangeClick" Padding="10,0" MinHeight="28" Height="28" BorderThickness="0" CornerRadius="4" />
                                    <ToggleButton Tag="30" Content="{Binding [30days], Source={StaticResource AppText}}" IsChecked="{x:Bind ViewModel.IsRange30, Mode=OneWay}" Click="OnActivityRangeClick" Padding="10,0" MinHeight="28" Height="28" BorderThickness="0" CornerRadius="4" />
                                    <ToggleButton Tag="7" Content="{Binding [7days], Source={StaticResource AppText}}" IsChecked="{x:Bind ViewModel.IsRange7, Mode=OneWay}" Click="OnActivityRangeClick" Padding="10,0" MinHeight="28" Height="28" BorderThickness="0" CornerRadius="4" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="2*,3*" ColumnSpacing="24">
                            <Grid x:Name="HealthScoreContent" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" VerticalAlignment="Top">
                                <TextBlock Text="{x:Bind ViewModel.HealthScoreLabel, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.HealthDeductionText, Mode=OneWay}" />
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <TextBlock x:Name="HealthScoreText" Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}" FontSize="48" LineHeight="54"
                                               Style="{StaticResource HeroNumberStyle}" AutomationProperties.Name="{x:Bind ViewModel.HealthScoreLabel, Mode=OneWay}" />
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalAlignment="Center">
                                        <Ellipse x:Name="HealthDot" Width="7" Height="7" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.HealthVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <Grid x:Name="HealthMeter" Grid.Row="2" Height="4" AutomationProperties.Name="{Binding [Healthmeter], Source={StaticResource AppText}}"
                                      AutomationProperties.HelpText="{x:Bind ViewModel.HealthDeductionText, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.HealthDeductionText, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="HealthMeterFillColumn" Width="0*" />
                                        <ColumnDefinition x:Name="HealthMeterRestColumn" Width="100*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Background="{ThemeResource MeterTrackBrush}" CornerRadius="3" />
                                    <Border x:Name="HealthMeterFill" CornerRadius="3" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" />
                            </Grid>
                            <Border Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding [Audits], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActivityScansText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="3" ToolTipService.ToolTip="{Binding [FindingstotaledacrossauditsRepeatedfindingsmayappearinmultiplescans], Source={StaticResource AppText}}">
                                            <TextBlock Text="{Binding [Recordedfindings], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.ActivityFindingsText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="3">
                                            <TextBlock Text="{Binding [Activedays], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActiveDaysText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="3" ToolTipService.ToolTip="{Binding [Onlyfullycoveredassessedauditscontributetothisaverage], Source={StaticResource AppText}}">
                                            <TextBlock Text="{Binding [Averagefullscope], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.AverageHealthText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer MaxHeight="108" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl DataContext="{x:Bind ViewModel}" ItemsSource="{x:Bind ViewModel.ActivityDays, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="{Binding ActivityColumns}" ItemWidth="18" ItemHeight="18" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DashboardDay">
                                                    <ToggleButton Tag="{x:Bind}" Width="16" MinWidth="16" Height="16" MinHeight="16" Padding="2" CornerRadius="3" BorderThickness="0"
                                                                  Background="{ThemeResource ControlFillColorTertiaryBrush}"
                                                                  IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="OnDayClick"
                                                                  AutomationProperties.Name="{x:Bind AccessibleLabel, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind AccessibleLabel, Mode=OneWay}">
                                                        <Grid Width="10" Height="10">
                                                            <Border CornerRadius="2" Background="{ThemeResource MeterTrackBrush}" />
                                                            <Border CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="{x:Bind ActivityOpacity, Mode=OneWay}" />
                                                        </Grid>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedDayText, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding [Latestaudit], Source={StaticResource AppText}}" Command="{x:Bind ViewModel.SelectLatestCommand}" Padding="8,0" Height="26" MinHeight="26" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ActivityHint, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedAuditLabel, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}" />
                                <Grid x:Name="AuditDetailsContent" ColumnDefinitions="*,*,2*,*" ColumnSpacing="16">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding [Scan], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.ScanTypeText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding [Finished], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.FinishedText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.FinishedText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="{Binding [Window], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.WindowText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.WindowText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Spacing="3">
                                        <TextBlock Text="{Binding [Eventsread], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.EventCountText, Mode=OneWay}" Style="{StaticResource BodySmallTextStyle}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Findings by category -->
                <Border x:Name="FindingsContent" Style="{StaticResource CardStyle}" AutomationProperties.Name="{Binding [Findings], Source={StaticResource AppText}}">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.FindingsHeading, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FindingsSummaryText, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <ToggleButton Tag="All" Height="28" MinHeight="28" Padding="10,0" CornerRadius="4" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterAll, Mode=OneWay}" AutomationProperties.Name="{Binding [Showallfindings], Source={StaticResource AppText}}">
                                    <TextBlock FontSize="12"><Run Text="{Binding [All], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.TotalFindings, Mode=OneWay}" /></TextBlock>
                                </ToggleButton>
                                <ToggleButton Tag="High" Height="28" MinHeight="28" Padding="10,0" CornerRadius="4" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterHigh, Mode=OneWay}" AutomationProperties.Name="{Binding [Showhighfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityHighFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [High], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.HighCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Tag="Medium" Height="28" MinHeight="28" Padding="10,0" CornerRadius="4" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterMedium, Mode=OneWay}" AutomationProperties.Name="{Binding [Showmediumfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityMediumFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [Medium], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.MediumCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Tag="Low" Height="28" MinHeight="28" Padding="10,0" CornerRadius="4" Click="OnFilterClick" IsChecked="{x:Bind ViewModel.IsFilterLow, Mode=OneWay}" AutomationProperties.Name="{Binding [Showlowfindings], Source={StaticResource AppText}}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SeverityLowFillBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"><Run Text="{Binding [Low], Source={StaticResource AppText}}" /><Run Text=" " /><Run Text="{x:Bind ViewModel.LowCount, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton Tag="All" Content="{x:Bind ViewModel.OverviewLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceAll, Mode=OneWay}" Click="OnSourceFilterClick" />
                                <ToggleButton Tag="Application" Content="{x:Bind ViewModel.ApplicationLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceApplication, Mode=OneWay}" Click="OnSourceFilterClick" />
                                <ToggleButton Tag="Security" Content="{x:Bind ViewModel.SecurityLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceSecurity, Mode=OneWay}" Click="OnSourceFilterClick" />
                                <ToggleButton Tag="Setup" Content="{x:Bind ViewModel.SetupLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceSetup, Mode=OneWay}" Click="OnSourceFilterClick" />
                                <ToggleButton Tag="System" Content="{x:Bind ViewModel.SystemLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceSystem, Mode=OneWay}" Click="OnSourceFilterClick" />
                                <ToggleButton Tag="ForwardedEvents" Content="{x:Bind ViewModel.ForwardedLabel, Mode=OneWay}" Height="30" MinHeight="30" Padding="10,0" CornerRadius="4" BorderThickness="0" Background="Transparent"
                                              IsChecked="{x:Bind ViewModel.IsSourceForwarded, Mode=OneWay}" Click="OnSourceFilterClick" />
                            </StackPanel>
                        </ScrollViewer>

                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12"
                                Visibility="{x:Bind ViewModel.HasAuditData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding [Auditcoverage], Source={StaticResource AppText}}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.CoverageState, Mode=OneWay}" Style="{StaticResource CaptionStrongTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CoverageText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind ViewModel.OccurrenceTimelineText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{Binding [Occurrencetimeline], Source={StaticResource AppText}}"
                                   AutomationProperties.Name="{Binding [Occurrencetimeline], Source={StaticResource AppText}}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.PriorityFindings.Count, Mode=OneWay, Converter={StaticResource NonZeroCountToVisibilityConverter}}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding [Priorityfindings], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}"
                                           ToolTipService.ToolTip="{Binding [Startherehighestseveritymostrepeatedandnewestevidence], Source={StaticResource AppText}}" />
                                <TextBlock Grid.Column="1" Text="{Binding [Top5], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PriorityFindings, Mode=OneWay}" ItemTemplate="{StaticResource FindingPreviewTemplate}" />
                        </StackPanel>

                        <TextBlock Text="{Binding [Findingsbycategory], Source={StaticResource AppText}}" Style="{StaticResource CaptionStrongTextStyle}"
                                   Visibility="{x:Bind ViewModel.FindingSections.Count, Mode=OneWay, Converter={StaticResource NonZeroCountToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FindingSections, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FindingSection">
                                    <Expander Margin="0,0,0,8"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Name}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Padding="0,4" HorizontalAlignment="Stretch">
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextStyle}" />
                                                    <TextBlock Text="{x:Bind SeveritySummary}" Style="{StaticResource CaptionTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Border Width="{x:Bind HighBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityHighFillBrush}" Visibility="{x:Bind HasHigh, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Width="{x:Bind MediumBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityMediumFillBrush}" Visibility="{x:Bind HasMedium, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <Border Width="{x:Bind LowBarWidth}" Height="6" CornerRadius="3" Background="{ThemeResource SeverityLowFillBrush}" Visibility="{x:Bind HasLow, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind CountLabel}" Style="{StaticResource CaptionTextStyle}" MinWidth="76" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{x:Bind Issues}" ItemTemplate="{StaticResource FindingPreviewTemplate}" Margin="0,4,0,0" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Padding="0,28" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoAudit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE9D9;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.HealthVerdict, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.HealthSummaryText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Padding="0,28" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowEmptyIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE946;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyFindingsTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyFindingsDescription, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                        <StackPanel Padding="0,20" Spacing="4" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowNoFilterMatches, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding [Nomatchingfindings], Source={StaticResource AppText}}" Style="{StaticResource BodyStrongTextStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding [Chooseanothersourceorseverityfilter], Source={StaticResource AppText}}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

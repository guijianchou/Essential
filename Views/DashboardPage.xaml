<Page
    x:Class="LocalSecurityAudit.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LocalSecurityAudit.Models"
    xmlns:vm="using:LocalSecurityAudit.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    Background="Transparent">
    <Grid Background="Transparent" RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              Height="60"
              Padding="32,0"
              ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <StackPanel Spacing="0">
                    <TextBlock Text="DASHBOARD" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Local security posture" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16"
                              Height="16"
                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                              AutomationProperties.Name="Audit in progress" />
                <Button Height="32" Padding="12,0" Command="{x:Bind ViewModel.LoadDataCommand}" AutomationProperties.Name="Refresh latest audit" ToolTipService.ToolTip="Reload the latest saved audit">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Refresh" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Height="32" Padding="12,0" Command="{x:Bind ViewModel.RunFastScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="Run fast scan" ToolTipService.ToolTip="Scan events since the last audit">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8FE;" FontSize="12" />
                        <TextBlock Text="Fast scan" FontSize="13" />
                    </StackPanel>
                </Button>
                <Button Height="32" Padding="12,0" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RunFullScanCommand}" IsEnabled="{x:Bind ViewModel.IsLoading, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" AutomationProperties.Name="Run full scan" ToolTipService.ToolTip="Scan the past 24 hours">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="Full scan" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="32,8,32,28"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
                <InfoBar Grid.Row="0"
                         IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         Closed="OnStatusBarClosed" />

                <Grid Grid.Row="1"
                      Height="238"
                      ColumnDefinitions="1.05*,1.05*,1.3*"
                      ColumnSpacing="16">
                    <Border Padding="18,16" Style="{StaticResource LayerCardStyle}" AutomationProperties.Name="Current health score">
                        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="HEALTH" Style="{StaticResource SectionLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="CURRENT POSTURE"
                                       Style="{StaticResource MetaLabelStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Width="148" Height="148" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="132" Height="132" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="8" />
                                <Path x:Name="HealthRing"
                                      Width="132"
                                      Height="132"
                                      Stretch="None"
                                      Stroke="{ThemeResource SystemFillColorSuccessBrush}"
                                      StrokeThickness="8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                    <TextBlock x:Name="HealthScoreText"
                                               Text="{x:Bind ViewModel.HealthScoreText, Mode=OneWay}"
                                               Style="{StaticResource MetricPrimaryStyle}"
                                               FontSize="30"
                                               HorizontalAlignment="Center"
                                               AutomationProperties.Name="Current health score" />
                                    <TextBlock Text="SCORE" Style="{StaticResource MetaLabelStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="18,16" Style="{StaticResource LayerCardStyle}" AutomationProperties.Name="Latest audit summary">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="LATEST AUDIT" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}"
                                           Style="{StaticResource MonoDetailStyle}"
                                           MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="SCANS" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ScanCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="EVENTS" Style="{StaticResource MetaLabelStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.EventCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource CardRuleStyle}" />
                            <Border Grid.Row="3" Style="{StaticResource InsetWellStyle}" Padding="10,8" VerticalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.ScanTypeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.TimeRangeText, Mode=OneWay}" Style="{StaticResource MonoDetailStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="18,16" Style="{StaticResource LayerCardStyle}" AutomationProperties.Name="Latest audit severity distribution">
                        <Grid RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="SEVERITY DISTRIBUTION" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Grid.Column="1" Text="LATEST" Style="{StaticResource MetaLabelStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Grid>
                            <lvc:PieChart Grid.Row="1"
                                          Margin="0,8,0,0"
                                          Series="{x:Bind ViewModel.SeverityPieSeries, Mode=OneWay}"
                                          AutomationProperties.Name="Latest audit severity distribution chart" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Height="420" Padding="18,16" VerticalAlignment="Top" Style="{StaticResource LayerCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="SECURITY FINDINGS" Style="{StaticResource SectionLabelStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Style="{StaticResource NumericTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="{x:Bind ViewModel.Issues.Count, Mode=OneWay}" />
                                <Run Text=" TOTAL" />
                            </TextBlock>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="2">
                            <TextBlock Text="HIGH" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="MEDIUM" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="LOW" Style="{StaticResource MetaLabelStyle}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.HighIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.MediumIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind ViewModel.LowIssueCount, Mode=OneWay}" Style="{StaticResource MetricCompactStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource CardRuleStyle}" />

                        <Grid Grid.Row="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0"
                                          AutomationProperties.Name="Security findings list">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.IssueGroups, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IssueGroup">
                                            <Border Padding="10,8" Margin="0,0,0,8" Style="{StaticResource InsetWellStyle}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                        <Border Width="4" Height="28" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{x:Bind GroupName}" Style="{StaticResource MetricSecondaryStyle}" />
                                                            <TextBlock Style="{StaticResource MonoDetailStyle}">
                                                                <Run Text="{x:Bind TotalCount}" />
                                                                <Run Text=" total  ·  C " />
                                                                <Run Text="{x:Bind CriticalCount}" />
                                                                <Run Text="  H " />
                                                                <Run Text="{x:Bind HighCount}" />
                                                                <Run Text="  M " />
                                                                <Run Text="{x:Bind MediumCount}" />
                                                                <Run Text="  L " />
                                                                <Run Text="{x:Bind LowCount}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <FontIcon Grid.Column="2" Glyph="{x:Bind GroupIcon}" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Grid>

                                                     <ItemsControl ItemsSource="{x:Bind CategorySections}">
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate x:DataType="vm:IssueCategorySection">
                                                                 <StackPanel Spacing="6">
                                                                     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Margin="2,2,2,0">
                                                                         <FontIcon Glyph="{x:Bind CategoryIcon}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                         <TextBlock Grid.Column="1" Text="{x:Bind CategoryName}" Style="{StaticResource MetaLabelStyle}" VerticalAlignment="Center" />
                                                                         <TextBlock Grid.Column="2" Style="{StaticResource MonoDetailStyle}" VerticalAlignment="Center">
                                                                             <Run Text="{x:Bind TotalCount}" />
                                                                             <Run Text="  ·  H " />
                                                                             <Run Text="{x:Bind HighCount}" />
                                                                             <Run Text="  M " />
                                                                             <Run Text="{x:Bind MediumCount}" />
                                                                             <Run Text="  L " />
                                                                             <Run Text="{x:Bind LowCount}" />
                                                                         </TextBlock>
                                                                     </Grid>
                                                                     <ItemsControl ItemsSource="{x:Bind Issues}">
                                                                         <ItemsControl.ItemTemplate>
                                                                             <DataTemplate x:DataType="models:AuditIssueEnhanced">
                                                                                 <Border Padding="8,8" Margin="0,0,0,6" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="5">
                                                                                     <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                                                                         <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                                             <TextBlock Text="{x:Bind Severity}" Style="{StaticResource MetaLabelStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                                                                             <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource MetricSecondaryStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                                                                             <StackPanel Grid.Column="2" Width="150" Spacing="1" HorizontalAlignment="Right">
                                                                                                 <TextBlock Text="DETECTED" Style="{StaticResource MetaLabelStyle}" HorizontalAlignment="Right" />
                                                                                                 <TextBlock Text="{x:Bind DetectedAtText}" Style="{StaticResource MonoDetailStyle}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                                                             </StackPanel>
                                                                                         </Grid>
                                                                                         <TextBlock Grid.Row="1" Text="{x:Bind RootCause}" Style="{StaticResource MonoDetailStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
                                                                                         <TextBlock Grid.Row="2" Text="{x:Bind Recommendation}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" />
                                                                                     </Grid>
                                                                                 </Border>
                                                                             </DataTemplate>
                                                                         </ItemsControl.ItemTemplate>
                                                                     </ItemsControl>
                                                                 </StackPanel>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.ShowEmptyIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE73E;" FontSize="30" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No security issues detected" Style="{StaticResource MetricSecondaryStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="The latest audit did not report any findings." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

<Application
    x:Class="LocalSecurityAudit.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:LocalSecurityAudit.Helpers"
    xmlns:converters="using:LocalSecurityAudit.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LayerCardBackgroundBrush" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#3DFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LayerCardBackgroundBrush" Color="#38FFFFFF" />
                    <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#20FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LayerCardBackgroundBrush" Color="#66101010" />
                    <SolidColorBrush x:Key="InsetBackgroundBrush" Color="#33101010" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="AppFontFamily">Segoe UI Variable</FontFamily>
            <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable</FontFamily>

            <x:Double x:Key="AppGutter">48</x:Double>
            <x:Double x:Key="CardPadding">18</x:Double>
            <x:Double x:Key="SectionSpacing">16</x:Double>

            <helpers:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <helpers:NonZeroCountToVisibilityConverter x:Key="NonZeroCountToVisibilityConverter" />
            <helpers:DoubleFormatConverter x:Key="DoubleFormatConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
            <converters:ModeToIndexConverter x:Key="ModeToIndexConverter" />
            <converters:ModelToIndexConverter x:Key="ModelToIndexConverter" />
            <converters:EffortToIndexConverter x:Key="EffortToIndexConverter" />

            <Style x:Key="AppTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}" />

            <Style x:Key="LayerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="InsetWellStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource InsetBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource LayerCardStyle}">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MetaLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="MetricPrimaryStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="MetricCompactStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricPrimaryStyle}">
                <Setter Property="FontSize" Value="18" />
            </Style>

            <Style x:Key="MetricStrongStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricPrimaryStyle}">
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="MetricSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NumericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="MonoDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="CardRuleStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource AppTextStyle}">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="MonoTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
